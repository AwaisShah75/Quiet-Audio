{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/image",
      "destination": "/converter/?type=image",
      "permanent": true
    },
    {
      "source": "/image/",
      "destination": "/converter/?type=image",
      "permanent": true
    },
    {
      "source": "/video",
      "destination": "/converter/?type=video",
      "permanent": true
    },
    {
      "source": "/video/",
      "destination": "/converter/?type=video",
      "permanent": true
    },
    {
      "source": "/audio-converter",
      "destination": "/converter/?type=audio",
      "permanent": true
    },
    {
      "source": "/audio-converter/",
      "destination": "/converter/?type=audio",
      "permanent": true
    },
    {
      "source": "/video-converter",
      "destination": "/converter/?type=video",
      "permanent": true
    },
    {
      "source": "/video-converter/",
      "destination": "/converter/?type=video",
      "permanent": true
    },
    {
      "source": "/image-converter",
      "destination": "/converter/?type=image",
      "permanent": true
    },
    {
      "source": "/image-converter/",
      "destination": "/converter/?type=image",
      "permanent": true
    },
    {
      "source": "/convert",
      "destination": "/converter/?type=audio&format=wav",
      "permanent": true
    },
    {
      "source": "/convert/",
      "destination": "/converter/?type=audio&format=wav",
      "permanent": true
    },
    {
      "source": "/extract",
      "destination": "/converter/?type=audio&format=wav",
      "permanent": true
    },
    {
      "source": "/extract/",
      "destination": "/converter/?type=audio&format=wav",
      "permanent": true
    }
  ]
}
